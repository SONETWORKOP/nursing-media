// ============================================================
// FIRESTORE RULES — Nursing Media
// Firebase Console → Firestore Database → Rules tab:
//   1. andar ka SAB kuch select-all karke DELETE karo
//   2. ye pura file paste karo → Publish
// ============================================================
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /site/config {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /sems/{sem}/subjects/{sub} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /users/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && (request.auth.token.email == "ojhashivam81@gmail.com" || request.auth.token.phone_number == "+919928096797");
    }

    match /paid_codes/{codeId} {
      allow get: if true;
      allow list: if request.auth != null && (request.auth.token.email == "ojhashivam81@gmail.com" || request.auth.token.phone_number == "+919928096797");
      allow create, update, delete: if request.auth != null && (request.auth.token.email == "ojhashivam81@gmail.com" || request.auth.token.phone_number == "+919928096797");
    }

    match /paid_notes/{noteId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && (request.auth.token.email == "ojhashivam81@gmail.com" || request.auth.token.phone_number == "+919928096797");
    }

  }
}
