// ============================================================
// STORAGE RULES — Nursing Media (PDF uploads)
// Paste: Firebase Console → Storage → Rules tab → Publish
// Matlab:
//  - PDFs: SAB download kar sakte hain, sirf LOGIN user upload kar sakta hai
// ============================================================
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /pdfs/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

  }
}
